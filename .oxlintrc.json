      // no warn line and no inline ignore: a hit is rewritten, or it goes to the owner. Today's app
      // keeps its hits and is not in `files`.
      "files": ["next/**", "kalfa/**", ".agents/**", "oxlint-plugins/**", ".github/ci/**"],
      "rules": { "oxc/no-accumulating-spread": "error" }
    },
    {
