{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
  "plugins": [
    {
      "name": "@effect/language-service",
      // Effect checks locked at error where they reached zero (ticket 1075, slices E4 to E25).
      // The globs read from this folder. One entry per set of folders; its comment names its checks.
      "overrides": [
        // Whole package: schemaNumber (E4), preferTypedSchemaDecoder (E5), unnecessaryTypeofType
        // (E7), unnecessaryArrowBlock (E8).
        {
          "include": ["**/*.ts"],
          "options": {
            "diagnosticSeverity": {
              "schemaNumber": "error",
              "preferTypedSchemaDecoder": "error",
              "unnecessaryTypeofType": "error",
              "unnecessaryArrowBlock": "error"
            }
          }
        }
      ]
    }
  ]
  },
  "include": ["src"]
}
