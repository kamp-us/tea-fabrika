{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Node runs the build without a transpiler. https://www.typescriptlang.org/tsconfig/erasableSyntaxOnly.html
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // An Effect.gen with a single return is the Effect itself: the checker's own fix. At zero in
        // the whole package, tests too.
        "overrides": [
          {
            "include": ["src/**/*.ts", "src/**/*.tsx"],
            "options": { "diagnosticSeverity": { "unnecessaryEffectGen": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
