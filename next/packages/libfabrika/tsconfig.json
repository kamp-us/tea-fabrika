{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Node runs the build without a transpiler. https://www.typescriptlang.org/tsconfig/erasableSyntaxOnly.html
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // A conditional inside flatMap is filterOrFail. On for the folders at zero, their tests too.
        // The globs read from this folder. Each slice that turns a check on adds its folders here.
        "overrides": [
          {
            "include": ["src/processes/**/*.ts", "src/telemetry/**/*.ts"],
            "options": { "diagnosticSeverity": { "flatMapConditionalToFilterOrFail": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
