{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Node runs the build without a transpiler. https://www.typescriptlang.org/tsconfig/erasableSyntaxOnly.html
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // A `typeof X.Type` query is the schema's own type name (E7, `unnecessaryTypeofType`). On for
        // the folders at zero, their tests too. The globs read from this folder. `src/runtime`,
        // `src/gateway` and `src/cloudflare` are other slices' folders, or hold files of pull
        // request 1366, so they wait.
        "overrides": [
          {
            "include": [
              "src/*.ts",
              "src/client/**/*.ts",
              "src/desktop/**/*.ts",
              "src/ledger/**/*.ts",
              "src/packs/**/*.ts",
              "src/permissions/**/*.ts",
              "src/processes/**/*.ts",
              "src/tasks/**/*.ts",
              "src/telemetry/**/*.ts"
            ],
            "options": { "diagnosticSeverity": { "unnecessaryTypeofType": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
