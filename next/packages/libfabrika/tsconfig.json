{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Node runs the build without a transpiler. https://www.typescriptlang.org/tsconfig/erasableSyntaxOnly.html
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // On for the folders at zero. The cloudflare folder joins when its slice reaches zero.
        // The globs read from this folder.
        "overrides": [
          {
            "include": ["src/processes/**/*.ts"],
            "options": { "diagnosticSeverity": { "catchConditionalRefailToCatchIf": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
