{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Node runs the build without a transpiler. https://www.typescriptlang.org/tsconfig/erasableSyntaxOnly.html
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // A service's key is the checker's own form, `<package>/<path>/<Class>` (0575), which took
        // over from our lint rule `service-id`. That rule read all of `src/`, so the lock does too,
        // tests included. The globs read from this folder.
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": { "diagnosticSeverity": { "deterministicKeys": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
