{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // E8: a block-bodied arrow that only returns an expression is an error here.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "unnecessaryArrowBlock": "error" }
      }
    ]
  },
  "include": ["*.ts", "gitignore.mjs", "css/*.ts", "../stylelint.config.ts"]
}
