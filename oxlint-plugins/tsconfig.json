{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
  "plugins": [
    {
      "name": "@effect/language-service",
      // Effect checks locked at error where they reached zero (ticket 1075, slices E4 to E25).
      // The globs read from this folder. One entry per set of folders; its comment names its checks.
      "overrides": [
        // Whole package: schemaNumber (E4), unnecessaryArrowBlock (E8).
        {
          "include": ["**/*.ts", "**/*.mjs"],
          "options": {
            "diagnosticSeverity": {
              "schemaNumber": "error",
              "unnecessaryArrowBlock": "error"
            }
          }
        },
        // These folders: schemaClassMissingBrand (E6).
        {
          "include": ["*.ts", "css/*.ts", "gitignore.mjs"],
          "options": {
            "diagnosticSeverity": {
              "schemaClassMissingBrand": "error"
            }
          }
        }
      ]
    }
  ]
  },
  "compilerOptions": { "allowJs": true, "checkJs": true },
  "include": ["*.ts", "gitignore.mjs", "css/*.ts", "../stylelint.config.ts"]
}
