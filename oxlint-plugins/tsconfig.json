{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // Effect's `schemaNumber` (E4). All of this folder is at zero. The globs read from this folder.
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          { "include": ["**/*.ts", "**/*.mjs"], "options": { "diagnosticSeverity": { "schemaNumber": "error" } } }
        ]
      }
    ]
  },
  "include": ["*.ts", "gitignore.mjs", "css/*.ts", "../stylelint.config.ts"]
}
