{
  "name": "@kalfa/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "!dist/.rsbuild"
  ],
  "exports": {
    "./Frontmatter": "./src/Frontmatter.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./Frontmatter": {
        "types": "./dist/Frontmatter.d.ts",
        "default": "./dist/Frontmatter.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
