{
  "name": "@kalfa/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Secrets by name: fetch a value or sign with a key, only for those allowed, every use recorded, the value never shown. A secret store holds the values, and the laws every store passes.",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/MemoryStore.ts",
    "./test": "./src/StoreTest.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@kalfa/config": "workspace:*"
  },
  "peerDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/vitest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
