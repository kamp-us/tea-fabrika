{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // A Schema class names its brand, so two classes with the same fields stay apart. On for the
        // whole folder, which is at zero.
        "overrides": [
          {
            "include": ["*.ts", "*.mjs", "workflow-lint/*.ts"],
            "options": { "diagnosticSeverity": { "schemaClassMissingBrand": "error" } }
          }
        ]
      }
    ]
  },
  "include": ["*.ts", "*.mjs", "workflow-lint/*.ts"]
}
