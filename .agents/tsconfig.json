{
  // Lead tooling (the quest, plan, mutation and sev scripts, and every other skill script): `scripts/typecheck.ts`
  // checks it after the packages, so a change to the Agent interface or to tea fails `pnpm typecheck` here first.
  // `.agents/` is no workspace package: its imports resolve from the root's own dependencies.
  //
  // Every `.ts` file under `skills/` is checked the day it is added: `include` is a glob, so a new file needs no
  // line here. The files that do not pass yet are in `exclude`, and that list only shrinks:
  // `next/apps/fabrika/src/exam/ratchet.ts` fails CI on a line added to it (ticket 2358). When you fix a file, delete
  // its line. To pass a new file, fix the file; do not add it to the list.
  // The ratchet reads this file after stripping whole-line `//` comments and nothing else, so keep every comment on
  // its own line, never after a value. It also refuses a file whose `include` lacks `skills/**/*.ts` or whose `extends`
  // is not `../tsconfig.base.json`, since the list would then be somewhere it does not read.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // Tooling scripts are programs, so they import Effect from the barrel, as 0577 has programs do
        // (call 2 of .kalfa/quests/effect-sweep-PLAN.md).
        "barrelImportPackages": ["effect"],
        "diagnosticSeverity": { "preferBarrelImport": "error" },
        // Effect checks locked at error where they reached zero (ticket 1075, slices E4 to E25).
        // The globs read from this folder. One entry per set of folders; its comment names its checks.
        "overrides": [
          // Whole package: schemaNumber (E4), preferTypedSchemaDecoder (E5),
          // schemaClassMissingBrand (E6), unnecessaryArrowBlock (E8), catchToOrElseSucceed (E9),
          // instanceOfSchema (E10), unnecessaryFailYieldableError (E19), multipleCatchTag (E21),
          // runOfExitToRunExit (E25).
          {
            "include": ["**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "schemaNumber": "error",
                "preferTypedSchemaDecoder": "error",
                "schemaClassMissingBrand": "error",
                "unnecessaryArrowBlock": "error",
                "catchToOrElseSucceed": "error",
                "instanceOfSchema": "error",
                "unnecessaryFailYieldableError": "error",
                "multipleCatchTag": "error",
                "runOfExitToRunExit": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["raw.d.ts", "skills/**/*.ts"],
  "exclude": [
    // Fails on its own: the checks it breaks, with counts. Fix the file, then delete its line.
    // TS2379
    "skills/lead/scripts/botpush.test.ts",
    // catchToOrElseSucceed x4
    "skills/lead/scripts/boxfiles.ts",
    // schemaClassMissingBrand
    "skills/lead/scripts/ci/History.ts",
    // schemaNumber x5, preferTypedSchemaDecoder x5, newSchemaClass x3, unnecessaryArrowBlock, TS7022
    "skills/lead/scripts/ci/HistoryGh.ts",
    // schemaNumber x2
    "skills/lead/scripts/ci/HistoryTest.ts",
    // schemaNumber x5, TS2550, TS7006
    "skills/lead/scripts/ci/Speed.ts",
    // newSchemaClass
    "skills/lead/scripts/ci/typecheck.test.ts",
    // allOfMapToForEach
    "skills/lead/scripts/gcloop.test.ts",
    // preferTypedSchemaDecoder
    "skills/lead/scripts/land.test.ts",
    // newSchemaClass x33, schemaClassMissingBrand x2, instanceOfSchema x2, catchToOrElseSucceed, preferTypedSchemaDecoder
    "skills/lead/scripts/land.ts",
    // TS2345 x2, TS2769
    "skills/lead/scripts/leakgrep.patches.test.ts",
    // newSchemaClass x7, preferTypedSchemaDecoder x3, schemaClassMissingBrand x2, schemaNumber, multipleCatchTag, catchToOrElseSucceed, TS2345
    "skills/lead/scripts/movecheck.ts",
    // preferTypedSchemaDecoder
    "skills/lead/scripts/pr/ClosesFs.test.ts",
