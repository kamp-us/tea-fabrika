{
  // The quest scripts (0031, ticket 486): `scripts/typecheck.sh` checks them after the packages, so
  // a change to the Agent interface or to tea fails `pnpm typecheck` here first. `.agents/` is no
  // workspace package: its imports resolve from the root's own dependencies. The other skill
  // scripts (the plan and mutation scripts) still hold type errors and join with ticket 486.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Effect's `schemaNumber`: a finite number is `Schema.Finite`, since `Schema.Number` also takes NaN and Infinity (E4). The globs read from this folder.
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [{ "include": ["**/*.ts"], "options": { "diagnosticSeverity": { "schemaNumber": "error" } } }]
      }
    ]
  },
  "include": [
    "raw.d.ts",
    "skills/lead/scripts/agents.ts",
    "skills/lead/scripts/box.ts",
    "skills/lead/scripts/box.rm.test.ts",
    "skills/lead/scripts/box/*.ts",
    "skills/lead/scripts/chain.ts",
    "skills/lead/scripts/chain.test.ts",
    "skills/lead/scripts/clauderow.ts",
    "skills/lead/scripts/clauderow.test.ts",
    "skills/lead/scripts/drive.ts",
    "skills/lead/scripts/drive.test.ts",
    "skills/lead/scripts/gc.ts",
    "skills/lead/scripts/gc.test.ts",
    "skills/lead/scripts/quests.ts",
    "skills/lead/scripts/quests.test.ts",
    "skills/lead/scripts/mutbox.ts",
    "skills/lead/scripts/mutbox.test.ts",
    "skills/lead/scripts/flow/*.ts",
    "skills/lead/scripts/flow/flows/*.ts",
    "skills/mutation/scripts/heartbeat.ts",
    "skills/mutation/scripts/heartbeat.test.ts",
    "skills/mutation/scripts/limit.ts",
    "skills/mutation/scripts/limit.test.ts",
    "skills/lead/scripts/sizecap.ts",
    "skills/lead/scripts/sizecap.test.ts",
    "skills/lead/scripts/records.ts",
    "skills/lead/scripts/records.test.ts",
    "skills/mutation/scripts/scope.ts",
    "skills/mutation/scripts/scope.test.ts",
    "skills/sev/scripts/*.ts"
  ]
}
