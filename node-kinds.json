{
  "entryExportConventions": {
    "alchemy-durable-object-export": {
      "files": "src/brain.ts",
      "exports": ["RecordPart", "Connection", "Process", "IsolateTail"]
    }
  },
  "testSupportFilePatterns": {
    "test-directory": ["(^|/)tests?/", "(^|/)__tests__/", "(^|/)e2e[^/]*/"],
    "test-helper-module": [
      "(^|/)test-helpers?/",
      "(^|/)test-utils?/",
      "(^|/)fixtures?/",
      "(^|/)test-helper\\.tsx?$",
      "(^|/)test-db\\.tsx?$",
      "\\.fixture\\.tsx?$"
    ],
    "test-support-module": ["\\.test-support\\.tsx?$"]
  }
}
